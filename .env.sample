# TurtlePi 项目配置（复制为 .env 后填写）
# ⚠️ .env 不进 git（已在 .gitignore）

# ── 智兔数服（股息率，免费 token）──
# 注册/查看：https://www.zhituapi.com/
ZHITU_TOKEN=CF2F9F23-90D7-4B06-BECA-ED950C3BC6B6

# ── Tushare Pro（可选，不配置则走免费源）──
# TUSHARE_TOKEN=your_token_here

# ── 筛选器开关 ──
# SCREENER_ENRICH_DV=1        是否补充股息率
# SCREENER_MAX_PAGES=30       分页上限
# SCREENER_SNAPSHOT_TTL=21600 快照缓存(秒)
# RATE_LIMIT_MIN_INTERVAL=0.5 同域请求间隔(秒)
# RATE_LIMIT_PAGE_INTERVAL=0.35 分页间隔(秒)
